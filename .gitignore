# Environment files (may contain secrets)
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.bak
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
*.iml

# Logs
*.log
logs/
# ...but test fixtures that happen to be logs are source. Without this the
# MariaDB slow-log fixture was never committed and its tests failed in CI.
!tests/fixtures/*.log

# Testing
test-deploy/
