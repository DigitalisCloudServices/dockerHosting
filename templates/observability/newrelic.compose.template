---
# New Relic Infrastructure agent — host-level singleton
# Managed by dockerHosting — do not edit by hand.
#
# Image tag is pinned. To update:
#   1. Verify the new tag on https://hub.docker.com/r/newrelic/infrastructure-bundle/tags
#   2. Update the version below
#   3. Re-run setup.sh --observability=newrelic --observability-key=<key> --force=observability

services:
  newrelic-infra:
    image: newrelic/infrastructure-bundle:3.4.0
    container_name: newrelic-infra
    restart: unless-stopped
    network_mode: host
    pid: host
    # userns_mode: host is required because the Linux kernel forbids combining
    # userns-remap (daemon.json: "userns-remap":"default") with host networking.
    userns_mode: "host"
    # cgroup: host is required on cgroup v2 hosts (Debian 13 is cgroup2fs),
    # where Docker defaults to a PRIVATE cgroup namespace. With a private
    # namespace the agent sees only its own namespace root: every other
    # container's ContainerSample reports 0 for CPU/memory/network, and this
    # container's row reports whole-host totals under the name newrelic-infra.
    # Verified on production 2026-09-19. New Relic's containerised-agent docs:
    # "--cgroupns=host ... required when using docker on cgroup v2".
    cgroup: host
    cap_add: [SYS_PTRACE]
    privileged: false
    volumes:
      - "/:/host:ro"
      - "/var/run/docker.sock:/var/run/docker.sock:ro"
      # Replaces the image's integrations.d. It holds docker-config.yml (the
      # nri-docker interval; see templates/observability/newrelic.docker-config.yml)
      # and any <site>-*.yml a site drops in. The agent ignores subfolders of
      # integrations.d, so site configs must live in this one folder; it
      # reloads on change, with no restart.
      - "./integrations.d:/etc/newrelic-infra/integrations.d:ro"
      # Site secrets (e.g. a monitoring account's password), root-only on the
      # host. A site config references them as /etc/newrelic-infra/secrets.d/<file>.
      - "/etc/observability/newrelic.d:/etc/newrelic-infra/secrets.d:ro"
      # Runs nri-mysql against a database container on an internal Docker
      # network; see templates/observability/newrelic.nri-mysql-docker.sh.
      - "./nri-mysql-docker.sh:/etc/newrelic-infra/bin/nri-mysql-docker.sh:ro"
      # Agent YAML for settings with no NRIA_* form (network_interface_filters);
      # see templates/observability/newrelic.infra.yml.
      - "./newrelic-infra.yml:/etc/newrelic-infra.yml:ro"
    env_file:
      - /etc/observability/newrelic.env
    environment:
      NRIA_OVERRIDE_HOST_ROOT: /host
      NEW_RELIC_REGION: EU
      NRIA_CUSTOM_ATTRIBUTES: '{"managed_by":"dockerHosting"}'
      # NRIA_DISPLAY_NAME is set in /etc/observability/newrelic.env, not here.
      # A compose `environment:` entry always wins over `env_file:`, and
      # "${HOSTNAME}" resolved to the empty string because HOSTNAME is a bash
      # internal, never exported, so docker compose never saw it. The agent
      # therefore reported with no display name at all.
      #
      # ── Ingest reduction ────────────────────────────────────────────────
      # Bridge-interface filtering (br-*, docker0) lives in newrelic-infra.yml:
      # network_interface_filters has no NRIA_* form, and setting it here made
      # envconfig reject the entire environment block, this comment's
      # neighbours included. Do NOT add it back as an env var.
      #
      # Sample rates in seconds. SystemSample backs the live host alerts, so
      # it is slowed rather than gutted; network and storage go to 1 minute.
      NRIA_METRICS_NETWORK_SAMPLE_RATE: 60
      NRIA_METRICS_STORAGE_SAMPLE_RATE: 60
      NRIA_METRICS_SYSTEM_SAMPLE_RATE: 30
      # ContainerSample (~13 GB/month, the largest single line item) is not
      # tunable through NRIA_* variables: nri-docker's interval lives in
      # /etc/newrelic-infra/integrations.d/docker-config.yml, which the
      # volume above replaces (15s -> 60s, a quarter of the rows). Until
      # cgroup: host was added, every one of those rows was zeros.
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      # Verified on the production host, 2026-09-02: FailingStreak 39708 while
      # the agent was reporting perfectly.
      #
      # Despite pid: host, the container's /proc view shows only a subset of
      # host processes (224 of them). The agent's own process -- whose comm is
      # exactly "newrelic-infra" -- is NOT among them, so `pgrep -x` finds
      # nothing and the check has never once passed. What IS visible is the
      # tini wrapper, `/sbin/tini -- /usr/bin/newrelic-infra-service`, and
      # `pgrep -f` matches that cmdline substring. Confirmed by running both
      # forms inside the container: -x no match, -f match.
      #
      # Matching the wrapper is an acceptable liveness proxy because tini is
      # the container's pid 1 and exits when its child does, so a dead agent
      # takes the container down rather than leaving this check falsely green.
      # The more rigorous option, if this ever needs to assert function rather
      # than liveness, is NRIA_STATUS_SERVER_ENABLED plus a request to
      # /v1/status/health on NRIA_STATUS_SERVER_PORT.
      test: ["CMD-SHELL", "pgrep -f /usr/bin/newrelic-infra >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
