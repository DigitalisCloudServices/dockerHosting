# /etc/apparmor.d/velaair-fuse
#
# Custom AppArmor profile for the VelaAir web container (F725).
# Equivalent to Docker's docker-default profile, with one delta:
# it permits mount(2) of FUSE-subtypes at /app/tiles, which is required
# for the gcsfuse-backed tile-access layer used by nginx in this container.
# Every other mount is denied by AppArmor's default-deny (the docker-default
# profile uses an explicit `deny mount,` rule; we drop that and rely on the
# default-deny for unlisted mount fstypes — explicit deny rules cannot be
# overridden by allow rules in AppArmor, so the docker-default pattern is
# incompatible with selectively permitting one fstype).  All other
# docker-default protections (proc, sys, ptrace, signal, file abstractions)
# are retained verbatim.
#
# Reload after edits:   sudo apparmor_parser -r /etc/apparmor.d/velaair-fuse
# Apply per-container:  --security-opt apparmor=velaair-fuse
#                       (compose: security_opt: [ "apparmor:velaair-fuse" ])

#include <tunables/global>

profile velaair-fuse flags=(attach_disconnected,mediate_deleted) {

  #include <abstractions/base>

  network,
  capability,
  file,
  umount,

  # F725: ALLOW fuse-subtype mounts ONLY at /app/tiles.  No `deny mount,`
  # follows — AppArmor default-denies any mount fstype not matched here.
  # gcsfuse mounts as fstype=fuse.gcsfuse; bare `fuse` is allowed too so a
  # future libfuse change does not silently break us.
  mount fstype=fuse -> /app/tiles/,
  mount fstype=fuse -> /app/tiles/**,
  mount fstype=fuse.* -> /app/tiles/,
  mount fstype=fuse.* -> /app/tiles/**,

  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (receive) peer=cri-containerd.apparmor.d,
  signal (send,receive) peer=velaair-fuse,
  signal (send,receive) peer=docker-default,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=velaair-fuse,
  ptrace (trace,read,tracedby,readby) peer=docker-default,
}
